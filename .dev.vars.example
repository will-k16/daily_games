# Copy to .dev.vars for local development. Never commit .dev.vars.

# Fake AI judges so you can play offline without any API keys.
#   Summit: a number in the answer sets its value ("rock 820").
#   Venn: "yes" fits every circle, "close" fits 2 of 3, "typo" asks "Did you mean"; puzzles come from the built-in bank.
MOCK_AI=1

# Lets you sign in as this email on localhost without Google (dev only).
DEV_LOGIN_EMAIL=will.kolander@gmail.com

# Real keys (optional locally; required in production)
# GEMINI_API_KEY=...      # fast backup judge (Gemini 3.5 Flash-Lite)
# GEMINI_SEARCH=on        # also use Gemini's Google Search (needs billing)
# GROQ_API_KEY=gsk_...    # backup judge
# JUDGE=groq              # put Groq first instead
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
